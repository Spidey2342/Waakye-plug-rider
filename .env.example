# Supabase connection (required)
VITE_SUPABASE_URL=https://verncapitxzsgcughvil.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Paystack LIVE public key for rider commission settlement (required in production)
# Dashboard → Settings → API Keys & Webhooks → Live public key (pk_live_…)
# Use pk_test_… only for local dev; production builds reject pk_test_.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your-key-here

# Support WhatsApp number (country code, no + or spaces)
# Falls back to 233599995651 if not set
VITE_SUPPORT_WHATSAPP=233599995651
